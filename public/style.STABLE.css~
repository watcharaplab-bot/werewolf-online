/* ===== WEREWOLF NEW GAME UI ===== */

.game-screen{
  min-height:100vh;
  background:
    radial-gradient(circle at 50% 0%,rgba(89,52,140,.25),transparent 45%),
    linear-gradient(180deg,#080811 0%,#11101a 100%);
}

/* TOP BAR */
.game-screen > header{
  min-height:72px;
  padding:14px 24px;
  background:rgba(12,11,20,.96);
  border-bottom:1px solid rgba(255,255,255,.08);
  box-shadow:0 8px 30px rgba(0,0,0,.35);
}

.game-screen #phaseTitle{
  color:#f0c674;
  font-size:22px;
  letter-spacing:1px;
}

.game-screen #nightNo{
  display:inline-block;
  margin-left:8px;
  padding:5px 12px;
  border-radius:20px;
  background:#2a203d;
  color:#d8c7ff;
  font-weight:700;
}

/* MAIN LAYOUT */
.new-game-layout{
  width:min(1180px,calc(100% - 32px));
  margin:24px auto 60px;
  display:grid;
  grid-template-columns:320px 1fr;
  gap:18px;
  align-items:start;
}

/* ALL GAME CARDS */
.game-screen .card{
  border:1px solid rgba(255,255,255,.08);
  background:linear-gradient(145deg,rgba(30,28,42,.96),rgba(17,16,25,.98));
  border-radius:18px;
  box-shadow:0 14px 35px rgba(0,0,0,.28);
}

/* ROLE CARD */
.game-screen .me{
  grid-column:1;
  grid-row:1;
  min-height:280px;
  text-align:center;
  position:sticky;
  top:90px;
}

.game-screen .myrole{
  padding:18px 10px;
}

.game-screen .roleEmoji{
  font-size:76px;
  line-height:1;
  margin:10px 0 18px;
  filter:drop-shadow(0 8px 18px rgba(0,0,0,.45));
}

.game-screen .roleTitle{
  font-size:28px;
  font-weight:900;
  color:#f0c674;
}

.game-screen .faction{
  margin-top:10px;
  opacity:.72;
}

/* PLAYER CARD */
.new-game-layout > .card:nth-child(2){
  grid-column:2;
  grid-row:1 / span 2;
}

.game-screen #gamePlayers{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
  margin-top:14px;
}

.game-screen #gamePlayers .player{
  min-height:76px;
  padding:14px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:14px;
  background:rgba(255,255,255,.035);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  gap:8px;
  text-align:center;
  transition:.2s ease;
}

.game-screen #gamePlayers .player:hover{
  transform:translateY(-2px);
  border-color:rgba(240,198,116,.45);
}

.game-screen #gamePlayers .player.dead{
  opacity:.38;
  filter:grayscale(1);
}

/* ACTION AREA */
.game-screen .actionCard{
  grid-column:1;
  grid-row:2;
}

.game-screen #actionTitle{
  color:#f0c674;
  text-align:center;
}

.game-screen #actions{
  display:grid;
  gap:10px;
}

.game-screen #actions button{
  min-height:50px;
  border-radius:12px;
  font-size:16px;
  font-weight:700;
}

/* MESSAGES */
.game-screen #gameMsg{
  margin-top:14px;
  padding:12px;
  text-align:center;
  border-radius:12px;
}

/* MOBILE */
@media(max-width:800px){
  .new-game-layout{
    width:min(100% - 20px,600px);
    grid-template-columns:1fr;
    margin-top:14px;
  }

  .game-screen .me,
  .new-game-layout > .card:nth-child(2),
  .game-screen .actionCard{
    grid-column:1;
    grid-row:auto;
    position:static;
  }

  .game-screen #gamePlayers{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .game-screen .roleEmoji{
    font-size:64px;
  }

  .game-screen .roleTitle{
    font-size:24px;
  }
}


/* ===== SELECT PLAYER FROM PLAYER GRID ===== */

.game-screen #gamePlayers .selectable-player{
  cursor:pointer;
  position:relative;
}

.game-screen #gamePlayers .selectable-player:hover{
  border-color:#8b5cf6;
  background:rgba(139,92,246,.10);
  transform:translateY(-2px);
}

.game-screen #gamePlayers .selected-player{
  border:2px solid #a855f7 !important;
  background:linear-gradient(
    135deg,
    rgba(109,40,217,.40),
    rgba(88,28,135,.28)
  ) !important;
  box-shadow:
    0 0 0 2px rgba(168,85,247,.15),
    0 0 24px rgba(168,85,247,.45);
  transform:translateY(-2px);
}

.game-screen #gamePlayers .selected-player::after{
  content:"✓";
  position:absolute;
  top:7px;
  right:9px;
  width:26px;
  height:26px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:#8b5cf6;
  color:white;
  font-size:16px;
  font-weight:900;
  box-shadow:0 0 15px rgba(139,92,246,.7);
}

.player-select-help{
  text-align:center;
  color:#c4b5fd;
}

.selected-summary{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:14px 16px;
  margin-bottom:10px;
  border-radius:12px;
  background:rgba(139,92,246,.12);
  border:1px solid rgba(167,139,250,.30);
}

.selected-summary b{
  color:#c4b5fd;
  font-size:17px;
}

